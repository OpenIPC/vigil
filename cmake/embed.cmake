# cmake -DOUT=file.c -DIN="a;b" -P embed.cmake: each file as a C array,
# web_<name> (name with dots as underscores) and web_<name>_len, NUL
# after the last byte. The zero channel's pages (src/api/web/) are served
# from these: vigild needs no files beside it.
file(WRITE ${OUT}.tmp "/* Generated by cmake/embed.cmake; do not edit. */\n#include <stddef.h>\n")
foreach(f ${IN})
  get_filename_component(n ${f} NAME)
  string(MAKE_C_IDENTIFIER ${n} id)
  file(READ ${f} hex HEX)
  string(LENGTH "${hex}" hl)
  math(EXPR len "${hl} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  file(APPEND ${OUT}.tmp "const unsigned char web_${id}[] = {${arr}0};\nconst size_t web_${id}_len = ${len};\n")
endforeach()
file(RENAME ${OUT}.tmp ${OUT})
